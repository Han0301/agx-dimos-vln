# Shared configuration for the DimOS virtualenv installer.

DIMOS_PYTHON_VERSION="${DIMOS_PYTHON_VERSION:-3.12}"
DIMOS_EXTRAS=(unitree navdp)
DIMOS_MIN_FREE_MB="${DIMOS_MIN_FREE_MB:-4096}"

DIMOS_REFERENCE_VENV="${DIMOS_REFERENCE_VENV:-$HOME/dimos/.venv}"
ROS2_BRIDGE_ROOT="${ROS2_BRIDGE_ROOT:-$HOME/dimos-ros2-bridge}"
ROS2_JAZZY="${ROS2_JAZZY:-$HOME/ros2_jazzy}"

SYSTEM_PACKAGES=(
  build-essential
  python3-dev
  git
  git-lfs
  libturbojpeg
  portaudio19-dev
  libgl1
  libegl1
)
