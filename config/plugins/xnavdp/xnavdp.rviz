Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane: XY
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Axes
    Name: Base Axes
    Enabled: true
    Length: 0.5
    Radius: 0.02
    Reference Frame: base_link
  - Class: rviz_default_plugins/Path
    Name: Selected Trajectory
    Enabled: true
    Topic:
      Value: /xnavdp/trajectory
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
    Buffer Length: 1
    Color: 38; 255; 77
    Line Style: Lines
    Line Width: 0.04
    Pose Style: None
  - Class: rviz_default_plugins/MarkerArray
    Name: Result Candidates Scores Goal
    Enabled: true
    Topic:
      Value: /xnavdp/result_markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/PointCloud2
    Name: D435 Point Cloud
    Enabled: true
    Topic:
      Value: /xnavdp/depth/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds: true
    Use Fixed Frame: true
  - Class: rviz_default_plugins/Image
    Name: Camera Color
    Enabled: true
    Topic:
      Value: /camera/camera/color/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Transport Hint: raw
    Normalize Range: true
    Min Value: 0
    Max Value: 255
    Median window: 5
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Pitch: 1.2
      Yaw: 3.14
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0
      Target Frame: base_link
Window Geometry:
  Width: 1400
  Height: 900
