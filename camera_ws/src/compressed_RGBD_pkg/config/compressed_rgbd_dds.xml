<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>compressed_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>compressed_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="compressed_rgbd_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>compressed_udp</transport_id>
        <transport_id>compressed_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>10.10.10.56</address>
              <port>7400</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>7400</port>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
      <flow_controller_descriptor_list>
        <flow_controller_descriptor>
          <name>compressed_async</name>
          <scheduler>FIFO</scheduler>
          <max_bytes_per_period>0</max_bytes_per_period>
          <period_ms>1</period_ms>
        </flow_controller_descriptor>
      </flow_controller_descriptor_list>
    </rtps>
  </participant>

  <data_writer profile_name="compressed_async_writer" is_default_profile="true">
    <qos>
      <publishMode>
        <kind>ASYNCHRONOUS</kind>
        <flow_controller_name>compressed_async</flow_controller_name>
      </publishMode>
    </qos>
  </data_writer>
</profiles>
